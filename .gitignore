# Microsemi Libero SoC Project .gitignore
# Generated for Libero v11.9 SP6

# Libero project files that should be excluded
*.prjx.bak
*.prjx.old

# Designer output files
designer/*.log
designer/*.rpt
designer/*.pin
designer/*.pdc_*
designer/*.sdc_*
designer/*.fdc_*
designer/*.gcf
designer/*.stp
designer/*.tcl
designer/impl*/
designer/run*/

# Synthesis output files (Synopsys Synplify Pro - all generated by Libero)
# Subdirectories
synthesis/synwork/
synthesis/synlog/
synthesis/syntmp/
synthesis/coreip/
synthesis/dm/
synthesis/backup/
# Netlists and databases
synthesis/*.edn
synthesis/*.sdf
synthesis/*.srr
synthesis/*.srd
synthesis/*.srm
synthesis/*.srs
synthesis/*.so
synthesis/*.map
synthesis/*.areasrr
# Reports
synthesis/*.rpt
synthesis/*.sap
synthesis/*.fse
synthesis/*.htm
synthesis/*.hdp
synthesis/*.vhm
synthesis/*.vm
# Project and script files (contain absolute paths, auto-regenerated)
synthesis/*.prj
synthesis/*.tcl
synthesis/*.bak
synthesis/*.pdc
synthesis/*.sdc
# Logs and temp
synthesis/*.log
synthesis/run_options.txt
synthesis/.recordref
synthesis/scratchproject.prs

# Simulation output files
simulation/*.log
simulation/*.wlf
simulation/*.vstf
simulation/work/
simulation/transcript
simulation/modelsim.ini
simulation/modelsim.ini.sav
simulation/wave.do
simulation/run.do

# SmartGen generated files
smartgen/*/
!smartgen/*/*.v
!smartgen/*/*.vhd

# CoreConsole generated files
coreconsole/*/

# Tool data and temporary files
tooldata/
tooldata/libero.*
*.bak
*.tmp
*.temp
*.cache

# ViewDraw - legacy schematic tool, not used in this project
# Entire folder excluded: contains only empty scaffolding and files
# with absolute paths (vf/project.lst) or local display prefs (viewdraw.ini)
viewdraw/

# Constraint files that are typically generated
constraint/*_derived*
constraint/*_imp*
constraint/*.sdc.bak

# Programming files
*.stp
*.pro
*.pdb

# Reports and logs
*.log
*.rpt
*.err

# Temporary and backup files
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# Windows specific
desktop.ini
*.lnk

# Editor specific
.vscode/
.idea/
*.sublime-*

# SmartDesign component generated files
# Keep: *.cxf (source), *.sdb (canvas layout)
# Exclude: generated HDL, stylesheets, reports with absolute paths
component/work/**/*.xsl
component/work/**/*_DataSheet.xml
component/work/**/*_DRC.xml
component/work/**/*_manifest.txt
#component/work/**/*.vhd

# Custom additions - uncomment as needed
# Add specific files you want to ignore
# my_custom_file.txt
# specific_directory/

# Keep important source files (examples - adjust as needed)
# !hdl/*.v
# !hdl/*.vhd
# !constraint/*.sdc
# !constraint/*.pdc